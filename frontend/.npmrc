# Configuración de seguridad para npm

# Auditoría obligatoria de dependencias
audit-level=moderate

# Validar integridad de paquetes
package-lock=true

# Usar npm ci en CI/CD (más seguro que install)
ci-strict=true

# Caché local (dentro del contenedor)
cache-min=9999999

# Usar el registro oficial de npm
registry=https://registry.npmjs.org/

# Evitar instalación de vulnerabilidades críticas
strict-ssl=true

# Timeout para descargas (en milisegundos)
fetch-timeout=60000
